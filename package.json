{
  "name": "mcp-tool-auditor",
  "version": "1.0.0",
  "description": "MCP server that audits tool descriptions for LLM reliability — detects smells, scores quality, and rewrites for better agent accuracy",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-tool-auditor": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:smoke": "tsx tests/smoke.ts"
  },
  "keywords": ["mcp", "model-context-protocol", "tool-audit", "llm-reliability", "agent-tools", "mcpize"],
  "author": "Prince Ruhul <princeruhulofficial@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14"
  },
  "engines": {
    "node": ">=18"
  }
}
